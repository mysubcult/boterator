services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    logging:
      options:
        max-size: "10m"
        max-file: "3"
    environment:
      POSTGRES_DB: boterator
      POSTGRES_USER: boterator
      POSTGRES_PASSWORD: boterator
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U boterator -d boterator"]
      interval: 5s
      timeout: 5s
      retries: 12

  app:
    build: .
    restart: unless-stopped
    logging:
      options:
        max-size: "10m"
        max-file: "3"
    depends_on:
      postgres:
        condition: service_healthy
    env_file:
      - .env
    environment:
      DATABASE_URL: postgresql://boterator:boterator@postgres:5432/boterator

volumes:
  pgdata:
