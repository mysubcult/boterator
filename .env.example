TG_TOKEN=123456:master-bot-token
DATABASE_URL=postgresql://boterator:boterator@postgres:5432/boterator
PUBLISH_MODE=forward
LOG_LEVEL=INFO
DATA_RETENTION_DAYS=90
CLEANUP_INTERVAL_HOURS=24

