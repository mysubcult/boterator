TG_TOKEN=123456:master-bot-token
DATABASE_URL=postgresql://boterator:boterator@postgres:5432/boterator
MASTER_OWNER_ID=
PUBLISH_MODE=forward
LOG_LEVEL=INFO
DATA_RETENTION_DAYS=90
CLEANUP_INTERVAL_HOURS=24

# Optional AI analysis: none, openai, gemini, deepseek
AI_PROVIDER=none

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# DeepSeek (text + images; videos and GIFs are analyzed by their preview frame)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# off, low, high, max
DEEPSEEK_REASONING_EFFORT=high
